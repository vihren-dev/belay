import Belay.Sqlite.Model.RowEngineResultLaws
import Belay.Sqlite.Model.RowEngineTriggers

set_option doc.verso true

open Belay.Sqlite.Model

namespace ProofBoundaries

/-- A nested run preserves the success and stop predicates for each permitted frame, work and
input state. Inputs that are not permitted or do not satisfy the success predicate impose no claim. -/
def RowKeeps (P : KeyState → Prop) (Q : KeyStop → Prop)
    (allowed : RowFrame → RowWork → KeyState → Prop) (nested : NestedRun) : Prop :=
  ∀ frame work state, allowed frame work state → P state → ResultHolds P Q (nested frame work state)

/-- The local facts used by trigger control: bookkeeping preserves good states, an undescribed
stop is allowed, and each error or explicit stop from a good state satisfies its own stop predicate.
The stop predicate can distinguish FAIL from rollback. -/
structure RowControlFacts (P : KeyState → Prop) (Q : KeyStop → Prop) : Prop where
  /-- Noting the target and subqueries of a successful nested write keeps the state predicate. -/
  afterStep : ∀ state table subqueries, P state → P (state.afterStep table subqueries)
  /-- Noting a query's subqueries keeps the state predicate. -/
  queried : ∀ state subqueries, P state →
    P { state with subqueried := state.subqueried || !(subqueries : List Resolved.Query).isEmpty }
  /-- The depth or support boundary satisfies the stop predicate. -/
  undescribed : Q .undescribed
  /-- An ordinary error from a good state satisfies the stop predicate. -/
  error : ∀ reason state, P state → Q (.error reason state)
  /-- FAIL and rollback each satisfy the stop predicate from a good state. -/
  stopped : ∀ algorithm state, P state → Q (.stopped algorithm state)

/-- Every nested write generated by this trigger step from a good state with its actual target
table is permitted. Query and RAISE steps generate no nested write. This follows execution's
frame and work construction, including an INSERT's inherited conflict algorithm. -/
def StepAllowed (P : KeyState → Prop) (allowed : RowFrame → RowWork → KeyState → Prop)
    (catalog : Catalog) (frame : RowFrame) (cells : List Value) : Resolved.Step → Prop
  | .insert position rows clauses own subqueries =>
    ∀ state table, P state → (state.database catalog).table position = some table →
      let context := Resolved.statementContext frame.clock {} [] (state.database catalog) subqueries
      let algorithm := frame.algorithm <|> own
      allowed { frame with algorithm }
        (.insert position (rowsWith context cells table.shape.columns rows)
          (catalog.writePolicy position table.shape algorithm) clauses true false) state
  | .update position assignments filter subqueries =>
    ∀ state table, P state → (state.database catalog).table position = some table →
      let context := Resolved.statementContext frame.clock {} [] (state.database catalog) subqueries
      let assigned := assignments.map Prod.fst
      allowed frame (.update position
        (fun row => LiteralData.movedRowid table.shape.rowidAlias
          (LiteralData.assignFrom context table.shape.columns assignments (row.values ++ cells) row))
        assigned (table.shape.changedColumns assigned) (selectedRowids context cells table filter) false) state
  | .delete position filter subqueries =>
    ∀ state table, P state → (state.database catalog).table position = some table →
      let context := Resolved.statementContext frame.clock {} [] (state.database catalog) subqueries
      allowed frame (.delete position (selectedRowids context cells table filter) false false true) state
  | .query .. | .raise .. => True

/-- From a good state, each RAISE kind satisfies its success or stop predicate. The proof
inspects the kind and uses the corresponding stop fact; IGNORE keeps the state. -/
theorem rowRaise {P Q} (facts : RowControlFacts P Q) {state : KeyState} (good : P state)
    (kind : Syntax.RaiseKind) : ResultHolds (fun pair : KeyState × Bool => P pair.1) Q (raiseEffect state kind) := by
  cases kind with
  | ignore => exact good
  | abort => exact facts.error _ _ good
  | fail => exact facts.stopped _ _ good
  | rollback => exact facts.stopped _ _ good

/-- A permitted trigger-entry deletion returns unit or satisfies the stop predicate.
The proof maps the nested-run contract and discards the successful state. -/
theorem rowEnter {P Q allowed nested} (keeps : RowKeeps P Q allowed nested)
    (frame : RowFrame) (table : Nat) {state : KeyState}
    (permitted : allowed frame (.delete table [] false false false) state) (good : P state) :
    ResultHolds (fun _ : Unit => True) Q (enterProgram nested frame table state) :=
  ResultHolds.map (keeps frame _ state permitted good) fun _ _ => trivial

end ProofBoundaries
