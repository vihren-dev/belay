  "findings": [
    {
      "id": "20261007T111133Z-2f43315b#1",
      "line": 124,
      "path": "reports/20261007-development-replay-executor-runtime/validate.py",
      "rule": "R11",
      "severity": "must",
      "text": "The validator reads `build/command-0000.json.gz` for each platform and `raw-sha256.json` lists both files, but `.gitignore` excludes `build/`, so the commit omits them and both checks crash on a clean checkout. Fix: force-track the two `build/command-0000.json.gz` files (or rename the directory so it is not ignored) and confirm that the file count matches the 47 artifacts that the README and status file claim."
    },
    {
      "id": "20261007T111133Z-2f43315b#2",
      "line": 41,
      "path": "reports/20261007-development-replay-executor-runtime/check_mutations.py",
      "rule": "R11",
      "severity": "should",
      "text": "The mutation check does not first confirm that the unchanged copy passes `validate`, so an unrelated assertion failure in the base data would count as a successful refusal of every mutation. Fix: call `validate(source)` once before the loop so that each refusal is caused by its mutation."
    },
    {
      "id": "20261007T111133Z-2f43315b#3",
      "line": 126,
      "path": "reports/20261007-development-replay-executor-runtime/validate.py",
      "rule": "R1",
      "severity": "should",
      "text": "The approved Nix build command is a list literal inside the per-platform check loop instead of a named policy definition with a docstring. Fix: define `APPROVED_BUILD_COMMAND` with a docstring next to the other constants and compare against it."
    },
    {
      "id": "20261007T111133Z-2f43315b#4",
      "line": 56,
      "path": "reports/20261007-development-replay-executor-runtime/validate.py",
      "rule": "R10",
      "severity": "should",
      "text": "Most assertions have no message, so a failed validation shows a bare `AssertionError` that does not say which artifact or field failed or what the user can do. Fix: add a message to each assertion that names the artifact, the field, and the expected value."
    }
  ],
