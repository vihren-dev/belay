python3 tools/check_resources.py || return 1
# The shell of shell.nix. Load it again when a file changes that its packages or the Lean
# toolchain come from.
watch_file nix/dev-shell.nix nix/sqlite.nix nix/flake.lock lean-toolchain build-support/lean-toolchain.nix build-support/locked-nixpkgs.nix
use nix
