import Belay.Sqlite.Tooling.Counterexamples.ReplaySyntaxExpr

set_option doc.verso true

namespace Belay.Sqlite.Replay
open Belay.Sqlite.Model

/-- The SQL spelling of a resolved JSON function. The two arrow functions are infix operators. -/
def jsonFunctionSql : Resolved.JsonFunction → String
  | .extract => "json_extract"
  | .arrowJson => "->"
  | .arrowValue => "->>"
  | .typeName => "json_type"
  | .valid => "json_valid"
  | .arrayLength => "json_array_length"
  | .json => "json"
  | .quote => "json_quote"
  | .array => "json_array"
  | .object => "json_object"
  | .set => "json_set"
  | .insert => "json_insert"
  | .replace => "json_replace"
  | .remove => "json_remove"
  | .patch => "json_patch"
  | .pretty => "json_pretty"
  | .errorPosition => "json_error_position"
  | .jsonb => "jsonb"
  | .jsonbExtract => "jsonb_extract"
  | .jsonbArray => "jsonb_array"
  | .jsonbObject => "jsonb_object"
  | .jsonbSet => "jsonb_set"
  | .jsonbInsert => "jsonb_insert"
  | .jsonbReplace => "jsonb_replace"
  | .jsonbRemove => "jsonb_remove"
  | .jsonbPatch => "jsonb_patch"

/-- The SQL spelling of a resolved scalar function, including the three trim functions. -/
def scalarFunctionSql : Resolved.ScalarFunction → String
  | .typeof => "typeof"
  | .length => "length"
  | .octetLength => "octet_length"
  | .abs => "abs"
  | .sign => "sign"
  | .zeroblob => "zeroblob"
  | .iif => "iif"
  | .nullif _ => "nullif"
  | .min _ => "min"
  | .max _ => "max"
  | .like => "like"
  | .glob => "glob"
  | .lower => "lower"
  | .upper => "upper"
  | .substr => "substr"
  | .instr => "instr"
  | .replace => "replace"
  | .trim .leading => "ltrim"
  | .trim .trailing => "rtrim"
  | .trim .both => "trim"
  | .hex => "hex"
  | .unhex => "unhex"
  | .quote => "quote"
  | .unistrQuote => "unistr_quote"
  | .char => "char"
  | .unicode => "unicode"
  | .unistr => "unistr"
  | .pipes => "||"
  | .concat => "concat"
  | .concatWs => "concat_ws"
  | .round => "round"
  | .floor => "floor"
  | .ceil => "ceil"
  | .trunc => "trunc"
  | .sqrt => "sqrt"
  | .pi => "pi"
  | .degrees => "degrees"
  | .radians => "radians"
  | .mod => "mod"
  | .printf => "printf"

end Belay.Sqlite.Replay
